{
  "openapi": "3.1.0",
  "info": {
    "title": "tecton API",
    "description": "tecton a text block indexing and search API with fulltext, vector, tree, and keyword search capabilities",
    "contact": {
      "name": "tecton Team",
      "email": "support@example.com"
    },
    "license": {
      "name": "MIT OR Apache-2.0",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    },
    {
      "url": "https://api.example.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/index/keywords": {
      "post": {
        "operationId": "update_keywords",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateKeywordsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": ""
          }
        }
      }
    },
    "/index/text": {
      "post": {
        "operationId": "index_text",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexTextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexResponse"
                }
              }
            }
          },
          "500": {
            "description": ""
          }
        }
      }
    },
    "/search/document/{name}": {
      "get": {
        "description": "Search all blocks for a named document.",
        "operationId": "by_name",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "style": "form"
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "404": {
            "description": "Invalid language argument"
          },
          "500": {
            "description": ""
          }
        }
      }
    },
    "/search/fulltext": {
      "post": {
        "description": "Fulltext search of the text field via query.",
        "operationId": "fulltext",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "500": {
            "description": ""
          }
        }
      }
    },
    "/search/id/{id}": {
      "get": {
        "description": "Return the block with the id or nothing.",
        "operationId": "by_id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "404": {
            "description": "Invalid language argument"
          },
          "500": {
            "description": ""
          }
        }
      }
    },
    "/search/keywords": {
      "post": {
        "description": "Search by keywords.",
        "operationId": "by_keywords",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchKeywordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "404": {
            "description": "Invalid language argument"
          },
          "500": {
            "description": ""
          }
        }
      }
    },
    "/search/stemming": {
      "post": {
        "description": "Word Stem (stemming) search of the text field via query for the specified language.",
        "operationId": "stemming",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchSternRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not active"
          },
          "500": {
            "description": ""
          }
        }
      }
    },
    "/search/tree": {
      "post": {
        "description": "Search by tree e.g. /root/first. Will respond with all documents of /root/first and possible children.",
        "operationId": "by_tree",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchTreeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "500": {
            "description": ""
          }
        }
      }
    },
    "/search/vector": {
      "post": {
        "operationId": "search_vector",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VectorSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not active"
          },
          "500": {
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IndexResponse": {
        "type": "object",
        "required": [
          "id",
          "indexed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "indexed": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "IndexTextRequest": {
        "type": "object",
        "required": [
          "text",
          "language",
          "document_name"
        ],
        "properties": {
          "date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "document_name": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "keywords": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "language": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "tree": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "KeywordAction": {
        "type": "string",
        "enum": [
          "add",
          "replace"
        ]
      },
      "SearchKeywordRequest": {
        "type": "object",
        "required": [
          "keys"
        ],
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "max_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "min_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "tree": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "max_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "min_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "query": {
            "type": [
              "string",
              "null"
            ]
          },
          "tree": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "results",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": [
          "id",
          "name",
          "date",
          "lang",
          "tree",
          "text",
          "score",
          "keywords"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lang": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "format": "float"
          },
          "text": {
            "type": "string"
          },
          "tree": {
            "type": "string"
          }
        }
      },
      "SearchSternRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "max_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "min_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "query": {
            "type": "string"
          },
          "tree": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SearchTreeRequest": {
        "type": "object",
        "required": [
          "tree"
        ],
        "properties": {
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "max_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "min_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "tree": {
            "type": "string"
          }
        }
      },
      "UpdateKeywordsRequest": {
        "type": "object",
        "required": [
          "id",
          "keywords",
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/KeywordAction"
          },
          "id": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "VectorSearchRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "min_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "query": {
            "type": "string"
          },
          "tree": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "index",
      "description": "Document indexing endpoints"
    },
    {
      "name": "search",
      "description": "Search endpoints"
    },
    {
      "name": "update",
      "description": "Document update endpoints"
    }
  ]
}